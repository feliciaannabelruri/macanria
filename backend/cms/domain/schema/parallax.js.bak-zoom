import { str, obj } from "./_helpers.js";

/* Skema PARALLAX — mengelola gambar cup pada engine parallax hero.
   Fokus tahap ini: mengganti gambar (image swapping). Tiga slot cup
   dipetakan ke elemen ber-atribut data-px di index.html:
     cupSilver -> #cup-silver, #s1-mobile-cup, lineup (Soymilk Tea)
     cupGuava  -> #cup-guava,  lineup (Pink Guava)
     cupMochi  -> #cup-mochi,  lineup (Yu Tou Mochi)
   Struktur sengaja dibuat mudah diperluas (mis. zoom/motion) tanpa
   mengubah kontrak yang ada. */
export default obj({
  cupSilver: str(200),
  cupGuava:  str(200),
  cupMochi:  str(200),
});
